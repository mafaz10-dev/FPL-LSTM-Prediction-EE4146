import os
import random
import numpy as np
import pandas as pd
import tensorflow as tf
from sklearn.preprocessing import MinMaxScaler
import pickle

# Set seeds
SEED = 17
random.seed(SEED)
np.random.seed(SEED)
tf.random.set_seed(SEED)

# Load data with team features (the enhanced version)
DATA_PATH = './data/'
positions = ['GK', 'DEF', 'MID', 'FWD']
data = {}
for pos in positions:
    data[pos] = pd.read_csv(os.path.join(DATA_PATH, f'{pos}_all_seasons.csv'))

# Add team features (same function as in notebook 04)
def add_team_features(df):
    df = df.copy()
    team_points = df.groupby(['season', 'GW', 'team'])['total_points'].sum().reset_index()
    team_points.rename(columns={'total_points': 'team_total_points'}, inplace=True)
    df = df.merge(team_points, on=['season', 'GW', 'team'], how='left')
    df['team_cumulative_points'] = df.groupby(['season', 'team'])['team_total_points'].cumsum()
    df['league_position'] = df.groupby(['season', 'GW'])['team_cumulative_points'].rank(ascending=False, method='dense')
    df['league_position_trend'] = df.groupby(['season', 'team'])['league_position'].transform(
        lambda x: x.rolling(3, min_periods=1).apply(
            lambda y: y.iloc[-1] - y.iloc[0] if len(y) > 1 else 0
        )
    )
    df['league_position'] = df['league_position'].fillna(10)
    df['team_total_points'] = df['team_total_points'].fillna(0)
    df['league_position_trend'] = df['league_position_trend'].fillna(0)
    return df

for pos in positions:
    data[pos] = add_team_features(data[pos])

# Features used in enhanced model
NEW_FEATURES = [
    'total_points', 'goals_scored', 'assists',
    'expected_goals', 'expected_assists', 'minutes',
    'engineered_form', 'was_home', 'clean_sheets',
    'league_position', 'team_total_points', 'league_position_trend'
]

# Optimal windows from enhanced grid search (replace with your actual values)
best_windows = {'GK': 4, 'DEF': 2, 'MID': 7, 'FWD': 7}  # Example from notebook 04 output

# Load saved enhanced models and scalers
saved_models = {}
saved_scalers = {}
for pos in positions:
    w = best_windows[pos]
    saved_models[pos] = tf.keras.models.load_model(f'enhanced_{pos}_w{w}.h5')
    with open(f'enhanced_{pos}_scaler.pkl', 'rb') as f:
        saved_scalers[pos] = pickle.load(f)

print("✅ Enhanced models and scalers loaded")

# Prediction function
def predict_next_gameweek(player_name, position, df, model, scaler, window_size, features=NEW_FEATURES):
    """
    Predict next gameweek points for a specific player.
    """
    player_data = df[df['name'] == player_name].sort_values(['season', 'GW'])
    if len(player_data) < window_size:
        return None, f"Not enough data for {player_name} (need {window_size} GWs)"
    last_games = player_data.tail(window_size)[features].values
    scaled = scaler.transform(last_games)
    X_input = scaled.reshape(1, window_size, len(features))
    pred = model.predict(X_input, verbose=0)
    return pred[0][0], None

# ============================================================
# TEST ON RANDOM PLAYERS FROM TEST SEASON (25/26)
# ============================================================

test_seasons = ['25_26']
random.seed(42)
np.random.seed(42)

print("="*80)
print("TESTING PREDICTIONS ON RANDOM PLAYERS (Test Season: 25/26)")
print("="*80)

all_test_results = []

for pos in positions:
    print(f"\n{'─'*40}")
    print(f"POSITION: {pos}  (optimal window = {best_windows[pos]})")
    print(f"{'─'*40}")

    df = data[pos]
    window = best_windows[pos]
    model = saved_models[pos]
    scaler = saved_scalers[pos]

    test_season_players = df[df['season'].isin(test_seasons)]['name'].unique()
    valid_players = []
    for player in test_season_players:
        player_df = df[df['name'] == player].sort_values(['season', 'GW'])
        test_rows = player_df[player_df['season'].isin(test_seasons)]
        if len(test_rows) > window:
            valid_players.append(player)

    if len(valid_players) == 0:
        print(f"  No valid players found for {pos}")
        continue

    sample_players = random.sample(valid_players, min(2, len(valid_players)))

    for player in sample_players:
        player_df = df[df['name'] == player].sort_values(['season', 'GW'])
        test_rows = player_df[player_df['season'].isin(test_seasons)]
        max_idx = len(test_rows) - 1
        if max_idx < window:
            continue
        random_idx = random.randint(window, max_idx)
        target_row = test_rows.iloc[random_idx]
        actual = target_row['Next_GW_Points']
        current_gw = target_row['GW']
        input_rows = test_rows.iloc[random_idx - window : random_idx]

        X_input = input_rows[NEW_FEATURES].values.reshape(1, window, len(NEW_FEATURES))
        X_scaled = scaler.transform(X_input.reshape(-1, len(NEW_FEATURES))).reshape(1, window, len(NEW_FEATURES))
        pred = model.predict(X_scaled, verbose=0)[0][0]

        all_test_results.append({
            'position': pos, 'player': player, 'window': window,
            'test_gw': current_gw, 'actual': actual, 'predicted': pred,
            'abs_error': abs(pred - actual)
        })

        print(f"\n  Player: {player}")
        print(f"  GW used as input: {input_rows['GW'].tolist()} → target GW: {current_gw}")
        print(f"  Last {window} GW points: {input_rows['total_points'].tolist()}")
        print(f"  Actual points in GW{current_gw}: {actual}")
        print(f"  Predicted points: {pred:.2f}")
        print(f"  |Error|: {abs(pred - actual):.2f}")

print("\n" + "="*80)
print("SUMMARY OF RANDOM TEST PREDICTIONS")
print("="*80)
results_df = pd.DataFrame(all_test_results)
print(results_df.to_string(index=False))
print(f"\nOverall average error: {results_df['abs_error'].mean():.3f} points")